# WhatsApp webhook (main.py)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
GEMINI_API_KEY=
WHATSAPP_PEDIDOS=51910371606
GRAPH_API_VERSION=v20.0
# Gemini (google-genai)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODELS_FALLBACK=gemini-3.5-flash,gemini-2.5-flash

# Filtro de ventas / coexistencia con WhatsApp Business app
# Si tiene valor (números separados por coma), el bot SOLO responde a esos números.
# Ejemplo: MODO_PRUEBA_NUMEROS=51999111222,51988776655
MODO_PRUEBA_NUMEROS=
# Horas de silencio en un chat cuando Rolly escribe desde la app Business (ecos smb_message_echoes).
SILENCIO_DUENO_HORAS=4

# Panel Financiero: plan Gratis con límites + plan Pro sin límites (incluye Asesor IA)
PANEL_INFO_URL=
# Link real del Panel (app web). Si está vacío se usa PANEL_COPY_URL o https://aro-finance-pro.web.app
PANEL_APP_URL=https://aro-finance-pro.web.app
PANEL_COPY_URL=
# Opcional: si está vacío, no se envía video (nunca se promete).
PANEL_VIDEO_URL=

# Conversación / seguimientos. SEGUIMIENTO_ACTIVO=0 (por defecto) no manda nada proactivo.
SEGUIMIENTO_ACTIVO=0
# Plantillas de WhatsApp (Meta, aprobadas) para escribir fuera de la ventana de 24 h.
WA_TEMPLATE_SEGUIMIENTO=
WA_TEMPLATE_FIN_PRUEBA=
WA_TEMPLATE_LANG=es
# Opcional: el cron POST /cron/seguimiento exige este valor en x-cron-secret si está definido.
CRON_SECRETO=
# Pro: días de prueba al entregar el Panel y precios en soles (montos exactos que valida Gemini Vision)
PRO_PRUEBA_DIAS=15
PRO_PRECIO_MENSUAL=19
PRO_PRECIO_ANUAL=149
# Días que suma cada pago de Pro
PRO_DIAS_MENSUAL=30
PRO_DIAS_ANUAL=365
# Límites del plan Gratis (viven en la plantilla de Google Sheets; el bot solo los comunica)
PLAN_GRATIS_MOVIMIENTOS=30
PLAN_GRATIS_FIADOS=3
# Pago: el QR oficial (qr_plin_oficial.png) acepta Plin y Yape. Hostéalo y pon la URL aquí
# o súbelo a WhatsApp Media y usa PAGO_QR_MEDIA_ID. No subas el PNG al repo.
PAGO_METODO=Plin o Yape (escanea el QR)
PAGO_TITULAR=Rolly Arnulfo López Aro
PAGO_NUMERO=
PAGO_QR_URL=
PAGO_QR_MEDIA_ID=
PAGO_DESTINATARIO_CLAVES=rolly,lopez
PAGO_VENTANA_MIN=60

# Mercado Pago (tarjeta, Checkout Pro). Si falta MP_ACCESS_TOKEN, el bot solo ofrece el QR Plin/Yape.
# En Render: Save only. Para pruebas usa el Access Token de prueba (empieza con TEST-).
MP_ACCESS_TOKEN=
# Opcional: firma secreta del webhook (Your integrations → Webhooks). Si está, se verifica x-signature.
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://bot-ventas-cables.onrender.com


# ARO Finance Pro (Firestore). Esta es la base de pagos, pruebas Pro y clientes.
# projectId de la app: aro-finance-pro
# Pega el JSON de la cuenta de servicio (o su base64). Nunca lo subas al repo.
FIREBASE_PROJECT_ID=aro-finance-pro
FIREBASE_SERVICE_ACCOUNT_JSON=
# Respaldo opcional en Google Sheets (si se deja vacío, no se usa):
SHEET_INGRESOS_ID=
# Columnas A:J como antes + K=plan (prueba_pro/gratis/pro_mensual/pro_anual), L=inicio prueba, M=vencimiento
SHEET_INGRESOS_RANGO=Ingresos!A:M
GOOGLE_SERVICE_ACCOUNT_JSON=
NOTIFICAR_A=

# Publicación Facebook / Instagram (bot.py + GitHub Actions)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
